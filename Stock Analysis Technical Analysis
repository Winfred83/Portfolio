      "source": [
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import pandas_ta as ta\n",
        "import matplotlib.pyplot as plt\n",
        "import math\n",
        "\n",
        "# -----------------------------\n",
        "# 1. User Inputs\n",
        "# -----------------------------\n",
        "symbols = [\"AAPL\", \"MSFT\", \"GOOGL\", \"AMZN\", \"TSLA\",\n",
        "           \"NFLX\", \"NVDA\", \"META\", \"BRK-B\", \"JPM\", \"ACN\"]\n",
        "\n",
        "start_date = \"2021-01-01\"\n",
        "end_date = \"2026-02-05\"\n",
        "\n",
        "ema_weeks = [2, 5, 10, 20, 30, 50, 60]\n",
        "ema_days = [w * 5 for w in ema_weeks]\n",
        "\n",
        "ema_combinations = [(s, l) for s in ema_weeks for l in ema_weeks if s < l]\n",
        "\n",
        "all_results = []\n",
        "\n",
        "# -----------------------------\n",
        "# 2. Backtest Loop\n",
        "# -----------------------------\n",
        "for symbol in symbols:\n",
        "\n",
        "    print(f\"\\n=== Backtesting {symbol} ===\")\n",
        "\n",
        "    df = yf.download(symbol, start=start_date, end=end_date)\n",
        "\n",
        "    if df.empty:\n",
        "        print(f\"No data for {symbol}\")\n",
        "        continue\n",
        "\n",
        "    if isinstance(df.columns, pd.MultiIndex):\n",
        "        df.columns = df.columns.get_level_values(0)\n",
        "\n",
        "    # Calculate EMAs\n",
        "    for w, d in zip(ema_weeks, ema_days):\n",
        "        if len(df) >= d:\n",
        "            df[f\"EMA{w}w\"] = ta.ema(df[\"Close\"], length=d)\n",
        "\n",
        "    ema_cols = [c for c in df.columns if c.startswith(\"EMA\")]\n",
        "    if not ema_cols:\n",
        "        continue\n",
        "\n",
        "    df.dropna(subset=ema_cols, inplace=True)\n",
        "\n",
        "    # Test combinations\n",
        "    for short_w, long_w in ema_combinations:\n",
        "\n",
        "        short_col = f\"EMA{short_w}w\"\n",
        "        long_col = f\"EMA{long_w}w\"\n",
        "\n",
        "        if short_col not in df.columns or long_col not in df.columns:\n",
        "            continue\n",
        "\n",
        "        temp = df.copy()\n",
        "        temp[\"Trend\"] = np.where(temp[short_col] > temp[long_col], 1, -1)\n",
        "\n",
        "        position = 0\n",
        "        trades = []\n",
        "\n",
        "        for i in range(1, len(temp)):\n",
        "\n",
        "            if position == 0:\n",
        "                if (temp[\"Trend\"].iloc[i] == 1 and\n",
        "                    temp[\"Close\"].iloc[i] < temp[short_col].iloc[i] and\n",
        "                    temp[\"Close\"].iloc[i-1] >= temp[short_col].iloc[i-1]):\n",
        "\n",
        "                    position = 1\n",
        "                    buy_price = temp[\"Close\"].iloc[i]\n",
        "\n",
        "            elif position == 1:\n",
        "                if temp[\"Trend\"].iloc[i] == -1:\n",
        "                    position = 0\n",
        "                    sell_price = temp[\"Close\"].iloc[i]\n",
        "                    trades.append(sell_price - buy_price)\n",
        "\n",
        "        total_trades = len(trades)\n",
        "        wins = [t for t in trades if t > 0]\n",
        "        total_profit = sum(trades)\n",
        "        win_rate = (len(wins) / total_trades * 100) if total_trades > 0 else 0\n",
        "\n",
        "        all_results.append({\n",
        "            \"Symbol\": symbol,\n",
        "            \"Short_EMA_w\": short_w,\n",
        "            \"Long_EMA_w\": long_w,\n",
        "            \"Total_Trades\": total_trades,\n",
        "            \"Win_Rate (%)\": round(win_rate, 2),\n",
        "            \"Total_PnL\": round(total_profit, 2)\n",
        "        })\n",
        "\n",
        "# -----------------------------\n",
        "# 3. Create Results Table\n",
        "# -----------------------------\n",
        "if not all_results:\n",
        "    print(\"No results generated.\")\n",
        "    exit()\n",
        "\n",
        "results_df = pd.DataFrame(all_results)\n",
        "results_df = results_df.sort_values(\n",
        "    by=[\"Symbol\", \"Total_PnL\"],\n",
        "    ascending=[True, False]\n",
        ")\n",
        "\n",
        "print(\"\\n========== SUMMARY TABLE ==========\\n\")\n",
        "print(results_df.groupby(\"Symbol\").first())\n",
        "\n",
        "# -----------------------------\n",
        "# 4. Plot ALL Stocks in ONE SCREEN\n",
        "# -----------------------------\n",
        "n = len(symbols)\n",
        "cols = 3\n",
        "rows = math.ceil(n / cols)\n",
        "\n",
        "fig, axes = plt.subplots(rows, cols, figsize=(22, 6 * rows))\n",
        "axes = axes.flatten()\n",
        "\n",
        "for idx, symbol in enumerate(symbols):\n",
        "\n",
        "    best = results_df[results_df[\"Symbol\"] == symbol]\n",
        "\n",
        "    if best.empty:\n",
        "        axes[idx].set_title(f\"{symbol} - No Data\")\n",
        "        continue\n",
        "\n",
        "    best = best.iloc[0]\n",
        "    short_w = best[\"Short_EMA_w\"]\n",
        "    long_w = best[\"Long_EMA_w\"]\n",
        "\n",
        "    df = yf.download(symbol, start=start_date, end=end_date)\n",
        "\n",
        "    if isinstance(df.columns, pd.MultiIndex):\n",
        "        df.columns = df.columns.get_level_values(0)\n",
        "\n",
        "    for w, d in zip(ema_weeks, ema_days):\n",
        "        if len(df) >= d:\n",
        "            df[f\"EMA{w}w\"] = ta.ema(df[\"Close\"], length=d)\n",
        "\n",
        "    df.dropna(inplace=True)\n",
        "\n",
        "    df[\"Trend\"] = np.where(\n",
        "        df[f\"EMA{short_w}w\"] > df[f\"EMA{long_w}w\"], 1, -1\n",
        "    )\n",
        "\n",
        "    df[\"BuyPrice\"] = np.nan\n",
        "    df[\"SellPrice\"] = np.nan\n",
        "    position = 0\n",
        "\n",
        "    for i in range(1, len(df)):\n",
        "\n",
        "        if position == 0:\n",
        "            if (df[\"Trend\"].iloc[i] == 1 and\n",
        "                df[\"Close\"].iloc[i] < df[f\"EMA{short_w}w\"].iloc[i] and\n",
        "                df[\"Close\"].iloc[i-1] >= df[f\"EMA{short_w}w\"].iloc[i-1]):\n",
        "\n",
        "                position = 1\n",
        "                df.at[df.index[i], \"BuyPrice\"] = df[\"Close\"].iloc[i]\n",
        "\n",
        "        elif position == 1:\n",
        "            if df[\"Trend\"].iloc[i] == -1:\n",
        "                position = 0\n",
        "                df.at[df.index[i], \"SellPrice\"] = df[\"Close\"].iloc[i]\n",
        "\n",
        "    ax = axes[idx]\n",
        "\n",
        "    ax.plot(df.index, df[\"Close\"], alpha=0.9)\n",
        "    ax.plot(df.index, df[f\"EMA{short_w}w\"], linestyle=\"--\")\n",
        "    ax.plot(df.index, df[f\"EMA{long_w}w\"], linestyle=\"--\")\n",
        "\n",
        "    ax.scatter(df.index, df[\"BuyPrice\"], marker=\"^\", color=\"green\", s=40)\n",
        "    ax.scatter(df.index, df[\"SellPrice\"], marker=\"v\", color=\"red\", s=40)\n",
        "\n",
        "    ax.set_title(\n",
        "        f\"{symbol}\\nEMA {short_w}/{long_w}w | \"\n",
        "        f\"PnL: {best['Total_PnL']} | \"\n",
        "        f\"WinRate: {best['Win_Rate (%)']}%\"\n",
        "    )\n",
        "\n",
        "    ax.grid(alpha=0.3)\n",
        "\n",
        "# Remove unused subplots\n",
        "for j in range(idx + 1, len(axes)):\n",
        "    fig.delaxes(axes[j])\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    }
